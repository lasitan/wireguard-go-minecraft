# Dual-server / TO NAT example — public node A
#
# Topology: C --ToNAT--> B --Endpoint--> A
# Same overlay: 10.0.0.0/24
#
# A is the public entry. Put C's VPN IP under B's AllowedIPs so A↔C
# traffic is routed via B.

[Interface]
PrivateKey = REPLACE_WITH_A_PRIVATE_KEY
Address = 10.0.0.1/24
ListenPort = 25565
MTU = 1420

[Peer]
# B (NAT gateway / dual-server)
PublicKey = REPLACE_WITH_B_PUBLIC_KEY
AllowedIPs = 10.0.0.2/32, 10.0.0.3/32
# Optional: ForwardTCP = 25565
