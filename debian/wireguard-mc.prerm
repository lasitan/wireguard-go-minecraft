#!/bin/sh
set -e

stop_wireguard_go_instances() {
	command -v systemctl >/dev/null 2>&1 || return 0
	for unit in $(systemctl list-units --type=service --state=running --no-legend 'wireguard-go@*' 2>/dev/null | awk '{print $1}'); do
		if command -v deb-systemd-invoke >/dev/null 2>&1; then
			deb-systemd-invoke stop "$unit" >/dev/null 2>&1 || true
		else
			systemctl stop "$unit" >/dev/null 2>&1 || true
		fi
	done
}

case "$1" in
remove | deconfigure)
	stop_wireguard_go_instances
	;;
upgrade | failed-upgrade)
	# Keep tunnels up during unpack; postinst will try-restart with new binary.
	;;
esac

#DEBHELPER#

exit 0
