#!/usr/bin/make -f

export DH_VERBOSE = 1
export GO111MODULE = on
export CGO_ENABLED = 0
export GOPROXY ?= https://proxy.golang.org,direct
export PATH := /usr/local/go/bin:$(PATH)

DEB_HOST_ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH)

ifeq ($(DEB_HOST_ARCH),amd64)
  GOARCH := amd64
else ifeq ($(DEB_HOST_ARCH),arm64)
  GOARCH := arm64
else ifeq ($(DEB_HOST_ARCH),armhf)
  GOARCH := arm
  export GOARM := 7
else ifeq ($(DEB_HOST_ARCH),i386)
  GOARCH := 386
else
  GOARCH := $(DEB_HOST_ARCH)
endif

export GOOS := linux
export GOARCH

VERSION := $(shell tr -d '\r\n\t ' < .github/build/version.txt)
LDFLAGS := -s -w -X golang.zx2c4.com/wireguard/src/core/version.Version=$(VERSION)

%:
	dh $@

override_dh_auto_clean:
	rm -f wireguard-go
	dh_auto_clean

override_dh_auto_build:
	@command -v go >/dev/null || { echo "go toolchain missing in PATH (expected /usr/local/go)"; exit 1; }
	go version
	go build -trimpath -ldflags "$(LDFLAGS)" -o wireguard-go ./src

override_dh_auto_test:
	@echo "Skipping unit tests during package build"

override_dh_auto_install:
	install -d debian/wireguard-mc/usr/bin
	install -m 0755 wireguard-go debian/wireguard-mc/usr/bin/wireguard-go
	install -d debian/wireguard-mc/etc/wireguard
	install -m 0644 deploy/examples/wireguard-go-master.json.example debian/wireguard-mc/etc/wireguard/wireguard-go-master.json.example
	install -m 0644 deploy/examples/wireguard-go-agent.json.example debian/wireguard-mc/etc/wireguard/wireguard-go-agent.json.example
	install -d debian/wireguard-mc/usr/share/doc/wireguard-mc
	install -m 0644 debian/README.Debian debian/wireguard-mc/usr/share/doc/wireguard-mc/README.Debian
	install -d debian/wireguard-mc/lib/systemd/system
	install -m 0644 debian/wireguard-go@.service debian/wireguard-mc/lib/systemd/system/wireguard-go@.service
	install -m 0644 debian/wireguard-go-master.service debian/wireguard-mc/lib/systemd/system/wireguard-go-master.service

override_dh_dwz:
	@echo "Skipping dh_dwz for Go binary"

override_dh_strip:
	dh_strip --no-automatic-dbgsym
