#!/usr/bin/make -f

export DH_VERBOSE = 1
export GO111MODULE = on
export CGO_ENABLED = 0
export GOPROXY ?= https://proxy.golang.org,direct
export PATH := /usr/local/go/bin:$(PATH)

DEB_HOST_ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH)

ifeq ($(DEB_HOST_ARCH),amd64)
  GOARCH := amd64
else ifeq ($(DEB_HOST_ARCH),arm64)
  GOARCH := arm64
else ifeq ($(DEB_HOST_ARCH),armhf)
  GOARCH := arm
  export GOARM := 7
else ifeq ($(DEB_HOST_ARCH),i386)
  GOARCH := 386
else
  GOARCH := $(DEB_HOST_ARCH)
endif

export GOOS := linux
export GOARCH

VERSION := $(shell tr -d '\r\n\t ' < .github/build/version.txt)
LDFLAGS := -s -w -X golang.zx2c4.com/wireguard/src/core/version.Version=$(VERSION)

%:
	dh $@

override_dh_auto_clean:
	rm -f lasitan-cluster
	dh_auto_clean

override_dh_auto_build:
	@command -v go >/dev/null || { echo "go toolchain missing in PATH (expected /usr/local/go)"; exit 1; }
	go version
	go build -trimpath -ldflags "$(LDFLAGS)" -o lasitan-cluster ./src

override_dh_auto_test:
	@echo "Skipping unit tests during package build"

override_dh_auto_install:
	install -d debian/lasitan-cluster/usr/bin
	install -m 0755 lasitan-cluster debian/lasitan-cluster/usr/bin/lasitan-cluster
	install -d debian/lasitan-cluster/etc/lasitan-cluster
	install -m 0644 deploy/examples/lasitan-cluster-master.json.example debian/lasitan-cluster/etc/lasitan-cluster/lasitan-cluster-master.json.example
	install -m 0644 deploy/examples/lasitan-cluster-agent.json.example debian/lasitan-cluster/etc/lasitan-cluster/lasitan-cluster-agent.json.example
	install -d debian/lasitan-cluster/usr/share/doc/lasitan-cluster
	install -m 0644 debian/README.Debian debian/lasitan-cluster/usr/share/doc/lasitan-cluster/README.Debian
	install -d debian/lasitan-cluster/lib/systemd/system
	install -m 0644 debian/lasitan-cluster@.service debian/lasitan-cluster/lib/systemd/system/lasitan-cluster@.service
	install -m 0644 debian/lasitan-cluster-master.service debian/lasitan-cluster/lib/systemd/system/lasitan-cluster-master.service

override_dh_dwz:
	@echo "Skipping dh_dwz for Go binary"

override_dh_strip:
	dh_strip --no-automatic-dbgsym
