#!/bin/sh
set -e

restart_lasitan_cluster_instances() {
	command -v systemctl >/dev/null 2>&1 || return 0
	systemctl daemon-reload >/dev/null 2>&1 || true

	# Collect interface names from running/enabled units and from conf files.
	ifaces=""
	for unit in $(systemctl list-units --type=service --all --no-legend 'lasitan-cluster@*' 2>/dev/null | awk '{print $1}'); do
		case "$unit" in
		lasitan-cluster@*.service)
			iface=${unit#lasitan-cluster@}
			iface=${iface%.service}
			ifaces="$ifaces $iface"
			;;
		esac
	done
	for conf in /etc/lasitan-cluster/*.conf; do
		[ -e "$conf" ] || continue
		case "$conf" in
		*.example) continue ;;
		esac
		iface=$(basename "$conf" .conf)
		ifaces="$ifaces $iface"
	done

	# Deduplicate and restart each instance that is enabled or was active.
	seen=" "
	for iface in $ifaces; do
		case "$seen" in
		*" $iface "*) continue ;;
		esac
		seen="$seen$iface "

		unit="lasitan-cluster@${iface}.service"
		if systemctl is-active --quiet "$unit" 2>/dev/null ||
			systemctl is-enabled --quiet "$unit" 2>/dev/null; then
			if command -v deb-systemd-invoke >/dev/null 2>&1; then
				deb-systemd-invoke try-restart "$unit" >/dev/null 2>&1 || true
			else
				systemctl try-restart "$unit" >/dev/null 2>&1 || true
			fi
			echo "lasitan-cluster: restarted $unit"
		fi
	done

	master="lasitan-cluster-master.service"
	if systemctl is-active --quiet "$master" 2>/dev/null; then
		if command -v deb-systemd-invoke >/dev/null 2>&1; then
			deb-systemd-invoke try-restart "$master" >/dev/null 2>&1 || true
		else
			systemctl try-restart "$master" >/dev/null 2>&1 || true
		fi
		echo "lasitan-cluster: restarted $master"
	fi
}

case "$1" in
configure)
	# Fresh install and apt upgrade/reconfigure: reload unit + restart tunnels.
	restart_lasitan_cluster_instances
	;;
abort-upgrade | abort-remove | abort-deconfigure) ;;
esac

#DEBHELPER#

exit 0
